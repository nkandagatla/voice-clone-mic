# Copy to .env and leave the key blank until you intentionally enable the live API.
# .env is gitignored. Do not put a real key in this example file.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_sts_v2
# Push-to-talk TTS only. Speech-to-speech keeps ELEVENLABS_MODEL_ID.
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_TTS_VOICE_ID=
ELEVENLABS_API_BASE=https://api.elevenlabs.io
VCM_INPUT_DEVICE=
VCM_OUTPUT_DEVICE=
